NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@ep-EXAMPLE-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DIRECT_URL=postgresql://cibilon:cibilon_dev_password@127.0.0.1:5433/cibilon?schema=public
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_POOL_CONNECT_TIMEOUT_MS=10000
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:4000/api/v1
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_ISSUER=cibilon-api
JWT_AUDIENCE=cibilon-web
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_COOKIE_NAME=cibilon_refresh
REFRESH_COOKIE_SAME_SITE=strict
COOKIE_SECURE=false
TRUST_PROXY=false
LOG_LEVEL=info
GLOBAL_RATE_LIMIT_WINDOW_MS=60000
GLOBAL_RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=50
LOGIN_RATE_LIMIT_MAX=10
METRICS_TOKEN=replace-with-at-least-32-random-characters
BCRYPT_ROUNDS=12
DATA_ENCRYPTION_KEY=GENERATE_A_UNIQUE_64_CHARACTER_HEX_KEY
DOCUMENT_ENCRYPTION_KEY=GENERATE_A_DIFFERENT_64_CHARACTER_HEX_KEY
SEED_DEFAULT_PASSWORD=SET_A_STRONG_TEST_PASSWORD
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./storage/documents
EXPORT_STORAGE_PATH=./storage/exports
EXPORT_JOB_POLL_MS=2000
MAX_DOCUMENT_SIZE_BYTES=10485760
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_KMS_KEY_ID=
S3_FORCE_PATH_STYLE=false
S3_SIGNED_URL_TTL_SECONDS=300
