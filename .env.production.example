NODE_ENV=production
API_HOST=0.0.0.0
API_PORT=4000
DATABASE_URL=postgresql://cibilon:CHANGE_ME@postgres:5432/cibilon?schema=public
DIRECT_URL=postgresql://cibilon:CHANGE_ME@postgres:5432/cibilon?schema=public
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_POOL_CONNECT_TIMEOUT_MS=10000
FRONTEND_ORIGIN=https://crm.example.com
JWT_ACCESS_SECRET=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
JWT_ACCESS_TTL_SECONDS=900
JWT_ISSUER=cibilon-api
JWT_AUDIENCE=cibilon-web
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_COOKIE_NAME=cibilon_refresh
REFRESH_COOKIE_SAME_SITE=strict
COOKIE_SECURE=true
TRUST_PROXY=true
LOG_LEVEL=info
GLOBAL_RATE_LIMIT_WINDOW_MS=60000
GLOBAL_RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=50
LOGIN_RATE_LIMIT_MAX=10
METRICS_TOKEN=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
BCRYPT_ROUNDS=12
DATA_ENCRYPTION_KEY=GENERATE_A_64_CHARACTER_HEX_KEY
DOCUMENT_ENCRYPTION_KEY=GENERATE_A_DIFFERENT_64_CHARACTER_HEX_KEY
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=/app/storage/documents
EXPORT_STORAGE_PATH=/app/storage/exports
EXPORT_JOB_POLL_MS=2000
MAX_DOCUMENT_SIZE_BYTES=10485760
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_KMS_KEY_ID=
S3_FORCE_PATH_STYLE=false
S3_SIGNED_URL_TTL_SECONDS=300
POSTGRES_DB=cibilon
POSTGRES_USER=cibilon
POSTGRES_PASSWORD=GENERATE_A_STRONG_DATABASE_PASSWORD
WEB_PORT=8080
